{
    "dataRoles": [
        {
            "displayName": "Toggles",
            "name": "toggle",
            "kind": "Grouping",
            "description": "One On/Off column per toggle (\"On\"/\"Off\", \"True\"/\"False\" or 1/0). Add one column for a single toggle, or several - normally from the same group table - for a group. A new empty slot appears below each column."
        },
        {
            "displayName": "Group enable",
            "name": "groupEnable",
            "kind": "Grouping",
            "description": "Optional. An On/Off column (normally in the same group table) drawn as a header toggle above the group - switching it Off greys out (disables) every toggle below it without changing their state."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "toggle": {
                        "max": 12
                    },
                    "groupEnable": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "groupEnable"
                            }
                        },
                        {
                            "for": {
                                "in": "toggle"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 10000
                        }
                    }
                }
            }
        }
    ],
