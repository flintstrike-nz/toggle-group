{
    "Visual_LandingPage_Heading": "Select or drag a field to populate this visual",
    "Visual_LandingPage_Heading.comment": "Landing page heading (next to an info icon) shown before any field is bound to the Toggle data role. Mirrors the host's own generic placeholder phrasing.",
    "Visual_LandingPage_Hint": "Accepts On/Off, True/False, or 1/0",
    "Visual_LandingPage_Hint.comment": "Small print under the landing page's skeleton preview, naming the accepted value formats up front so a report author doesn't have to hit the validation message first.",
    "Visual_LandingPage_GuideTableIntro": "To get started, create a disconnected table:",
    "Visual_LandingPage_GuideTableIntro.comment": "First step of the copyable starter-DAX guide on the landing page, introducing the DATATABLE code block below it.",
    "Visual_LandingPage_GuideMeasureIntro": "Then add a measure:",
    "Visual_LandingPage_GuideMeasureIntro.comment": "Second step of the starter-DAX guide, introducing the SELECTEDVALUE measure code block below it.",
    "Visual_LandingPage_GuideOutro": "Then bind the Toggle field above and use the switch as a filter.",
    "Visual_LandingPage_GuideOutro.comment": "Closing line of the starter-DAX guide, after both code blocks.",
    "Visual_LandingPage_CopyButton": "Copy",
    "Visual_LandingPage_CopyButton.comment": "Button label on each starter-DAX code block. Also the label it's restored to after the brief \"Copied!\"/\"Copy failed\" confirmation.",
    "Visual_LandingPage_CopyButton_Copied": "Copied!",
    "Visual_LandingPage_CopyButton_Copied.comment": "Replaces the Copy button's label for ~1.5s after a successful copy.",
    "Visual_LandingPage_CopyButton_Failed": "Copy failed",
    "Visual_LandingPage_CopyButton_Failed.comment": "Replaces the Copy button's label for ~1.5s if both clipboard approaches fail (e.g. denied by the host's iframe sandbox).",
    "Visual_LandingPage_CopyTable_AriaLabel": "Copy the disconnected table DAX",
    "Visual_LandingPage_CopyTable_AriaLabel.comment": "Accessible name for the Copy button on the DATATABLE code block.",
    "Visual_LandingPage_CopyMeasure_AriaLabel": "Copy the measure DAX",
    "Visual_LandingPage_CopyMeasure_AriaLabel.comment": "Accessible name for the Copy button on the SELECTEDVALUE measure code block.",
    "Visual_Validation_OnOffRequired": "Toggle field must contain exactly one On row and one Off row (\"On\"/\"Off\", \"True\"/\"False\", or 1/0).",
    "Visual_Validation_OnOffRequired.comment": "Shown once a field is bound to Toggle but its values don't match one of the accepted On/Off patterns.",
    "Visual_Tooltip_Label": "Toggle",
    "Visual_Tooltip_Label.comment": "Header shown in the hover tooltip, followed by the current On/Off label.",
    "Visual_Switch_AriaLabel": "{0} / {1} toggle, currently {2}",
    "Visual_Switch_AriaLabel.comment": "Accessible name for the switch control when toggleSettings.controlStyle is \"toggle\". {0} and {1} are the report's Off/On labels from the Format pane; {2} repeats whichever of them is currently active. ILocalizationManager has no format-argument support, so these are replaced by literal position in code - keep the {N} tokens intact when translating and reorder them (not the surrounding words) if the target language needs a different word order.",
    "Visual_Checkbox_AriaLabel": "{0} / {1} checkbox, currently {2}",
    "Visual_Checkbox_AriaLabel.comment": "Same as Visual_Switch_AriaLabel, used instead when toggleSettings.controlStyle is \"checkbox\" (matching the control's role=\"checkbox\" at that point) so the accessible name doesn't call a checkbox-shaped control a \"toggle\". Same {0}/{1}/{2} token contract.",
    "Visual_ToggleSettingsCard_DisplayName": "Toggle Settings",
    "Visual_ToggleSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_ControlStyle_DisplayName": "Control style",
    "Visual_ControlStyle_Description": "Draw the control as a sliding Toggle switch, or a square Checkbox.",
    "Visual_OnColor_DisplayName": "On colour",
    "Visual_OnColor_Description": "Fill colour of the switch track when it is On.",
    "Visual_OffColor_DisplayName": "Off colour",
    "Visual_OffColor_Description": "Fill colour of the switch track when it is Off.",
    "Visual_OnLabel_DisplayName": "On label",
    "Visual_OnLabel_Description": "Text shown next to the switch when it is On.",
    "Visual_OffLabel_DisplayName": "Off label",
    "Visual_OffLabel_Description": "Text shown next to the switch when it is Off.",
    "Visual_ShowLabels_DisplayName": "Show labels",
    "Visual_ShowLabels_Description": "Show the On/Off label text next to the switch when there's room for it. Turn off to always hide it.",
    "Visual_LabelPosition_DisplayName": "Label position",
    "Visual_LabelPosition_Description": "Show a single label matching the current state, to the left or right of the switch (Label left / Label right), or centred above it (Above).",
    "Visual_ToggleAlignment_DisplayName": "Alignment",
    "Visual_ToggleAlignment_Description": "Position of the switch+label row within the tile: hugging the left edge, hugging the right edge, or Justify (spread the label and switch to opposite ends).",
    "Visual_LabelSpacing_DisplayName": "Label spacing",
    "Visual_LabelSpacing_Description": "Space in pixels between the switch and its label(s).",
    "Visual_LabelFont_DisplayName": "Font",
    "Visual_LabelFont_DisplayName.comment": "FontControl row label (family/size/bold/italic/underline) for the On/Off label text.",
    "Visual_LabelFontColor_DisplayName": "Font colour",
    "Visual_LabelFontColor_Description": "Colour of the On/Off label text.",
    "Visual_ShowBackground_DisplayName": "Show switch background",
    "Visual_ShowBackground_Description": "Fill a background behind the switch and its label(s). Off by default so the visual shows through the report's own card/canvas background. Separate from Power BI's own native General → Background, which every visual gets automatically - turning this off won't affect that one.",
    "Visual_BackgroundColor_DisplayName": "Switch background colour",
    "Visual_BackgroundColor_Description": "Fill colour behind the switch and its label(s), shown when Show switch background is on.",
    "Visual_ShowBorder_DisplayName": "Show border",
    "Visual_ShowBorder_Description": "Show a coloured border around the switch track. Off by default.",
    "Visual_BorderColor_DisplayName": "Border colour",
    "Visual_BorderColor_Description": "Colour of the switch track's border, shown when Show border is on.",
    "Visual_BorderWidth_DisplayName": "Border width",
    "Visual_BorderWidth_Description": "Width in pixels of the switch track's border, shown when Show border is on.",
    "Visual_DepthEffect_DisplayName": "Make it fancy!",
    "Visual_DepthEffect_Description": "Give the switch a raised, glossy look with shading and shadows instead of a flat fill.",
    "Visual_TitleSettingsCard_DisplayName": "Title",
    "Visual_TitleSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_TitleText_DisplayName": "Title text",
    "Visual_TitleText_Description": "Static heading text this visual renders itself, positioned beside or above the switch. Shows \"Toggle label\" until you set your own text; clear it to show no title.",
    "Visual_TitleText_Default": "Toggle label",
    "Visual_TitleText_Default.comment": "Shown as the title's own runtime text whenever a report author hasn't set one yet (the property has no persisted value) - resolved via ILocalizationManager rather than a hardcoded default in settings.ts, since unlike onLabel/offLabel this is likely to go untouched and appear as-is in production reports.",
    "Visual_TitlePosition_DisplayName": "Title position",
    "Visual_TitlePosition_Description": "Show the title before the switch (Inline left), after it (Inline right), or centred above it (Above).",
    "Visual_TitleAlignment_DisplayName": "Alignment",
    "Visual_TitleAlignment_Description": "Position of the title+switch group within the tile: hugging the left edge, hugging the right edge, or Justify (spread the title and switch to opposite ends).",
    "Visual_TitleSpacing_DisplayName": "Title spacing",
    "Visual_TitleSpacing_Description": "Space in pixels between the switch and the title.",
    "Visual_TitleFont_DisplayName": "Font",
    "Visual_TitleFont_DisplayName.comment": "FontControl row label (family/size/bold/italic/underline) for the title text.",
    "Visual_TitleFontColor_DisplayName": "Font colour",
    "Visual_TitleFontColor_Description": "Colour of the title text.",
    "Visual_SizeSettingsCard_DisplayName": "Size",
    "Visual_SizeSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_SizeMode_DisplayName": "Size mode",
    "Visual_SizeMode_Description": "Scale the switch fluidly between Min/Max height as the tile is resized (Responsive), or lock it to one Fixed height regardless of tile size.",
    "Visual_MinHeight_DisplayName": "Min height",
    "Visual_MinHeight_Description": "Smallest height in pixels the switch scales down to in Responsive mode. Width follows at a fixed 2:1 ratio.",
    "Visual_MaxHeight_DisplayName": "Max height",
    "Visual_MaxHeight_Description": "Largest height in pixels the switch scales up to in Responsive mode. Width follows at a fixed 2:1 ratio.",
    "Visual_FixedHeight_DisplayName": "Fixed height",
    "Visual_FixedHeight_Description": "Exact height in pixels the switch is drawn at in Fixed mode, regardless of tile size. Width follows at a fixed 2:1 ratio.",
    "Visual_Debug_SelectionResolved": "{0}() resolved: {1}",
    "Visual_Debug_SelectionResolved.comment": "TEMP DEBUG - shown in place of the validation message after a selectionManager call succeeds during interactive troubleshooting. {0} is the operation name (\"clear\" or \"select\"), {1} is the JSON-stringified result.",
    "Visual_Debug_SelectionThrew": "{0}() threw: {1}",
    "Visual_Debug_SelectionThrew.comment": "TEMP DEBUG - shown in place of the validation message when a selectionManager call throws during interactive troubleshooting. {0} is the operation name (\"clear\" or \"select\") that was actually in flight when the error occurred, {1} is the error's string representation."
}
