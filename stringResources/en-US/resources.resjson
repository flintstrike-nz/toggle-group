{
    "Visual_LandingPage_Heading": "Drag one field per toggle into Toggles to build the group",
    "Visual_LandingPage_Heading.comment": "Landing page heading (next to an info icon) shown before any field is bound to the Toggles data role.",
    "Visual_LandingPage_Hint": "Each field accepts On/Off, True/False, or 1/0. A new empty slot appears after each one.",
    "Visual_LandingPage_Hint.comment": "Small print under the landing page's skeleton preview, naming the accepted value formats and the one-field-per-toggle model up front so a report author doesn't have to hit the validation message first.",
    "Visual_LandingPage_GuideTableIntro": "1. For each toggle, create a small disconnected table. Its column name becomes the toggle's name:",
    "Visual_LandingPage_GuideTableIntro.comment": "First step of the copyable starter-DAX guide on the landing page, introducing the DATATABLE code block below it.",
    "Visual_LandingPage_GuideMeasureIntro": "2. Add a measure that reads it:",
    "Visual_LandingPage_GuideMeasureIntro.comment": "Second step of the starter-DAX guide, introducing the SELECTEDVALUE measure code block below it.",
    "Visual_LandingPage_CopyButton": "Copy",
    "Visual_LandingPage_CopyButton.comment": "Button label on each starter-DAX code block. Also the label it's restored to after the brief \"Copied!\"/\"Copy failed\" confirmation.",
    "Visual_LandingPage_CopyButton_Copied": "Copied!",
    "Visual_LandingPage_CopyButton_Copied.comment": "Replaces the Copy button's label for ~1.5s after a successful copy.",
    "Visual_LandingPage_CopyButton_Failed": "Copy failed",
    "Visual_LandingPage_CopyButton_Failed.comment": "Replaces the Copy button's label for ~1.5s if both clipboard approaches fail (e.g. denied by the host's iframe sandbox).",
    "Visual_LandingPage_CopyTable_AriaLabel": "Copy the toggle table DAX",
    "Visual_LandingPage_CopyTable_AriaLabel.comment": "Accessible name for the Copy button on the DATATABLE code block.",
    "Visual_LandingPage_CopyMeasure_AriaLabel": "Copy the measure DAX",
    "Visual_LandingPage_CopyMeasure_AriaLabel.comment": "Accessible name for the Copy button on the SELECTEDVALUE measure code block.",
    "Visual_Validation_OnOffRequired": "\"{0}\" must contain exactly one On row and one Off row (\"On\"/\"Off\", \"True\"/\"False\", or 1/0). Each toggle needs its own small table - see the starter DAX on this visual's landing page.",
    "Visual_Validation_OnOffRequired.comment": "Shown once a field is bound to Toggles or Group enable but its values don't match one of the accepted On/Off patterns. {0} is the offending field's display name - keep the token intact when translating.",
    "Visual_Switch_AriaLabel": "{0}: {1} / {2} toggle, currently {3}",
    "Visual_Switch_AriaLabel.comment": "Accessible name for a row drawn with the toggle skin. {0} is the row's name (its field's display name, or the master label); {1} and {2} are the report's Off/On labels from the Format pane; {3} is whichever of them is currently active (or Visual_State_Mixed). ILocalizationManager has no format-argument support, so these are replaced by literal position in code - keep the {N} tokens intact when translating and reorder them (not the surrounding words) if the target language needs a different word order.",
    "Visual_Checkbox_AriaLabel": "{0}: {1} / {2} checkbox, currently {3}",
    "Visual_Checkbox_AriaLabel.comment": "Same as Visual_Switch_AriaLabel, used instead when a row is announced as role=\"checkbox\" (the checkbox skin, header rows under the radio skin, or radio-skinned rows outside Only one active). Same {0}/{1}/{2}/{3} token contract.",
    "Visual_ToggleSettingsCard_DisplayName": "Toggle Settings",
    "Visual_ToggleSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_ControlStyle_DisplayName": "Control style",
    "Visual_ControlStyle_Description": "Draw each toggle as a sliding Toggle switch, a square Checkbox, or a round Radio button.",
    "Visual_OnColor_DisplayName": "On colour",
    "Visual_OnColor_Description": "Fill colour of each toggle when it is On.",
    "Visual_OffColor_DisplayName": "Off colour",
    "Visual_OffColor_Description": "Fill colour of each toggle when it is Off.",
    "Visual_OnLabel_DisplayName": "On label",
    "Visual_OnLabel_Description": "State text shown next to a toggle when it is On.",
    "Visual_OffLabel_DisplayName": "Off label",
    "Visual_OffLabel_Description": "State text shown next to a toggle when it is Off.",
    "Visual_ShowLabels_DisplayName": "Show labels",
    "Visual_ShowLabels_Description": "Show On/Off state text next to each toggle when there's room for it. Turn off to always hide it.",
    "Visual_LabelPosition_DisplayName": "Label position",
    "Visual_LabelPosition_Description": "Show the current state's text to the left or right of each toggle (Label left / Label right), or centred above it (Above).",
    "Visual_LabelSpacing_DisplayName": "Label spacing",
    "Visual_LabelSpacing_Description": "Space in pixels between the switch and its label(s).",
    "Visual_LabelFont_DisplayName": "Font",
    "Visual_LabelFont_DisplayName.comment": "FontControl row label (family/size/bold/italic/underline) for the On/Off label text.",
    "Visual_LabelFontColor_DisplayName": "Font colour",
    "Visual_LabelFontColor_Description": "Colour of the On/Off label text.",
    "Visual_ShowBackground_DisplayName": "Show group background",
    "Visual_ShowBackground_Description": "Fill a background inside the group's container. Off by default so the visual shows through the report's own card/canvas background. Separate from Power BI's own native General → Background, which every visual gets automatically - turning this off won't affect that one.",
    "Visual_BackgroundColor_DisplayName": "Group background colour",
    "Visual_BackgroundColor_Description": "Fill colour inside the group's container, shown when Show group background is on.",
    "Visual_ShowBorder_DisplayName": "Show border",
    "Visual_ShowBorder_Description": "Show a coloured border around each toggle's track. Off by default.",
    "Visual_BorderColor_DisplayName": "Border colour",
    "Visual_BorderColor_Description": "Colour of each toggle track's border, shown when Show border is on.",
    "Visual_BorderWidth_DisplayName": "Border width",
    "Visual_BorderWidth_Description": "Width in pixels of each toggle track's border, shown when Show border is on.",
    "Visual_DepthEffect_DisplayName": "Make it fancy!",
    "Visual_DepthEffect_Description": "Give every toggle a raised, glossy look with shading and shadows instead of a flat fill.",
    "Visual_TitleSettingsCard_DisplayName": "Title",
    "Visual_TitleSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_TitleText_DisplayName": "Title text",
    "Visual_TitleText_Description": "Static heading text this visual renders itself, above or beside the group. Shows \"Toggle group\" until you set your own text; clear it to show no title.",
    "Visual_TitleText_Default": "Toggle group",
    "Visual_TitleText_Default.comment": "Shown as the title's own runtime text whenever a report author hasn't set one yet (the property has no persisted value) - resolved via ILocalizationManager rather than a hardcoded default in settings.ts, since unlike onLabel/offLabel this is likely to go untouched and appear as-is in production reports.",
    "Visual_TitlePosition_DisplayName": "Title position",
    "Visual_TitlePosition_Description": "Show the title above the group (Above), before it (Inline left), or after it (Inline right).",
    "Visual_TitleAlignment_DisplayName": "Alignment",
    "Visual_TitleAlignment_Description": "Position of the title+group assembly within the container: hugging the left edge, hugging the right edge, or Justify (spread the title and group to opposite ends).",
    "Visual_TitleSpacing_DisplayName": "Title spacing",
    "Visual_TitleSpacing_Description": "Space in pixels between the title and the group.",
    "Visual_TitleFont_DisplayName": "Font",
    "Visual_TitleFont_DisplayName.comment": "FontControl row label (family/size/bold/italic/underline) for the title text.",
    "Visual_TitleFontColor_DisplayName": "Font colour",
    "Visual_TitleFontColor_Description": "Colour of the title text.",
    "Visual_SizeSettingsCard_DisplayName": "Size",
    "Visual_SizeSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_SizeMode_DisplayName": "Size mode",
    "Visual_SizeMode_Description": "Scale the toggles fluidly with the tile's height (shared across all rows) between Min/Max height (Responsive), or lock them to one Fixed height regardless of tile size.",
    "Visual_MinHeight_DisplayName": "Min height",
    "Visual_MinHeight_Description": "Smallest height in pixels each toggle scales down to in Responsive mode. Width follows at a fixed ratio (2:1 toggle, 1:1 checkbox/radio).",
    "Visual_MaxHeight_DisplayName": "Max height",
    "Visual_MaxHeight_Description": "Largest height in pixels each toggle scales up to in Responsive mode. Width follows at a fixed ratio (2:1 toggle, 1:1 checkbox/radio).",
    "Visual_FixedHeight_DisplayName": "Fixed height",
    "Visual_FixedHeight_Description": "Exact height in pixels each toggle is drawn at in Fixed mode, regardless of tile size. Width follows at a fixed ratio (2:1 toggle, 1:1 checkbox/radio).",
    "Visual_LandingPage_GuideRepeat": "3. Repeat for each toggle, then drag each table's column into Toggles.",
    "Visual_LandingPage_GuideRepeat.comment": "Third step of the starter-DAX guide, after the measure code block.",
    "Visual_LandingPage_GuideEnableIntro": "Optional: build a \"Group Enable\" table the same way, drag it into Group enable, and gate each measure on it (Group enable is On until first switched Off, hence the fallback of 1):",
    "Visual_LandingPage_GuideEnableIntro.comment": "Optional final step of the starter-DAX guide, introducing the gated-measure code block below it. Keep the \"Group Enable\" table name in sync with the DAX code block, which isn't localized.",
    "Visual_LandingPage_CopyGate_AriaLabel": "Copy the group-enable measure DAX",
    "Visual_LandingPage_CopyGate_AriaLabel.comment": "Accessible name for the Copy button on the gated (Group enable) measure code block.",
    "Visual_Radio_AriaLabel": "{0}: {1} / {2} option, currently {3}",
    "Visual_Radio_AriaLabel.comment": "Same as Visual_Switch_AriaLabel, used instead when a row is announced as role=\"radio\" (the radio skin under Only one active). Same {0}/{1}/{2}/{3} token contract.",
    "Visual_State_Mixed": "Mixed",
    "Visual_State_Mixed.comment": "The master switch's state when only some of the toggles below it are On. Used in its accessible name and tooltip.",
    "Visual_MasterLabel_Default": "All",
    "Visual_MasterLabel_Default.comment": "Shown as the master switch's name until a report author sets their own Master label - resolved via ILocalizationManager (like Visual_TitleText_Default) since it's likely to go untouched.",
    "Visual_GroupSettingsCard_DisplayName": "Group rules",
    "Visual_GroupSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_OnlyOneActive_DisplayName": "Only one active",
    "Visual_OnlyOneActive_Description": "Turning a toggle On turns every other toggle in the group Off.",
    "Visual_MasterSwitch_DisplayName": "Master switch",
    "Visual_MasterSwitch_Description": "Add a master toggle to the top of the group. Turning it On or Off does the same to every toggle below it.",
    "Visual_MasterLabel_DisplayName": "Master label",
    "Visual_MasterLabel_Description": "Name shown next to the master toggle. Shows \"All\" until you set your own.",
    "Visual_Indent_DisplayName": "Indent",
    "Visual_Indent_Description": "Pixels each level of toggles is indented below a master or Group enable toggle.",
    "Visual_RowSpacing_DisplayName": "Row spacing",
    "Visual_RowSpacing_Description": "Space in pixels between toggle rows.",
    "Visual_NameSettingsCard_DisplayName": "Toggle names",
    "Visual_NameSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_ShowNames_DisplayName": "Show names",
    "Visual_ShowNames_Description": "Show each toggle's name - its field name. Rename the field in the Toggles well to change it.",
    "Visual_NamePosition_DisplayName": "Name position",
    "Visual_NamePosition_Description": "Show each name to the left or right of its toggle.",
    "Visual_NameAlignment_DisplayName": "Alignment",
    "Visual_NameAlignment_Description": "Pack names and toggles to the Left or Right, or Justify them to opposite edges of the group.",
    "Visual_NameSpacing_DisplayName": "Name spacing",
    "Visual_NameSpacing_Description": "Space in pixels between each name and its toggle.",
    "Visual_NameFont_DisplayName": "Font",
    "Visual_NameFont_DisplayName.comment": "FontControl row label (family/size/bold/italic/underline) for the toggle names.",
    "Visual_NameFontColor_DisplayName": "Font colour",
    "Visual_NameFontColor_Description": "Colour of the toggle names.",
    "Visual_ContainerSettingsCard_DisplayName": "Container",
    "Visual_ContainerSettingsCard_DisplayName.comment": "Format pane card heading grouping the properties below.",
    "Visual_ContainerBorderStyle_DisplayName": "Border style",
    "Visual_ContainerBorderStyle_Description": "Border drawn around the whole group: None, Flat (a plain line), Embossed (raised) or Gutter (recessed).",
    "Visual_ContainerBorderColor_DisplayName": "Border colour",
    "Visual_ContainerBorderColor_Description": "Colour of the group's border.",
    "Visual_ContainerBorderWidth_DisplayName": "Border width",
    "Visual_ContainerBorderWidth_Description": "Width in pixels of the group's border.",
    "Visual_ContainerCornerRadius_DisplayName": "Corner radius",
    "Visual_ContainerCornerRadius_Description": "Roundness in pixels of the group's corners.",
    "Visual_ContainerPadding_DisplayName": "Padding",
    "Visual_ContainerPadding_Description": "Space in pixels between the group's border and its contents.",
    "Visual_ContainerVerticalAlignment_DisplayName": "Vertical alignment",
    "Visual_ContainerVerticalAlignment_Description": "Where the title and toggles sit vertically inside the container."
}
